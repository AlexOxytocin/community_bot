[Unit]
Description=Community Bot PostgreSQL logical backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/community-bot/current/ops/backup_postgres.py
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/community-bot /opt/community-bot/shared
