# Safe local-development placeholders only.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://community_bot:community_bot@localhost:5432/community_bot
POSTGRES_DB=community_bot
POSTGRES_USER=community_bot
POSTGRES_PASSWORD=community_bot
