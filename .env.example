# Safe local-development placeholders only.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://community_bot:community_bot@localhost:5432/community_bot
POSTGRES_DB=community_bot
POSTGRES_USER=community_bot
POSTGRES_PASSWORD=community_bot
POSTGRES_PORT=5432
# Outbound notifications only; the legacy Telegram chat UI no longer runs.
BOT_TOKEN=
# Set a unique random value of at least 32 bytes before enabling invite creation.
INVITE_TOKEN_SECRET=
SENTRY_DSN=
RELEASE=local
NOTIFICATION_WINDOW_START_LOCAL=09:00
NOTIFICATION_WINDOW_END_LOCAL=21:00
WORKER_BATCH_SIZE=25
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=120
HEARTBEAT_MAX_AGE_SECONDS=180
COMMUNITY_BOT_IMAGE=community-bot:local
